---
import IsotypeIcon from "./ui/IsotypeIcon.astro";


---

<div id="splash-screen" class="fixed inset-0 z-50 flex items-center justify-center bg-white">
  <div class="text-center">
    <div id="splash-logo" class="w-10 h-10 text-gray-500 mb-4 opacity-100">
       <IsotypeIcon />
    </div>
  </div>
</div>
<style>
  #splash-screen {
    transition: opacity 0.5s ease;
  }
  html.splash-active {
    overflow: hidden; /* Disables scroll */
  }
</style>