---
import DownloadIcon from "../ui/DownloadIcon.astro";
import LinkButton from "../ui/LinkButton.astro";
import { m } from '../../paraglide/messages';
---

<div class="flex flex-col-reverse xl:flex-row gap-1 w-full *max-w-5xl">
    <div class="w-full h-full flex flex-col gap-8 justify-center items-start">
        <h1 id="hero-name" data-loading="true" class="px-2 w-full text-4xl tracking-tighter text-balance max-lg:font-medium max-sm:px-4 sm:text-5xl lg:text-6xl xl:text-8xl font-switzer-l">
            {m["hero_section.greetings"]()}
        </h1>
        <p class="max-w-(--breakpoint-md) mx-4 px-2 text-base/7 text-gray-500 border border-blue-500/80 relative before:content-['description-span'] before:absolute before:text-xs/6 before:-left-px before:-top-7 before:bg-blue-500/80 before:py-0.5 before:px-1 before:text-white before:font-mono before:whitespace-pre">
            { m["hero_section.description"]() }
        </p>
        <div class="px-4 flex gap-2 flex-row items-center justify-start">
            <LinkButton target="_blank" width="[14rem]" id="downloadCVButton" href="/downloadable_resources/Gerardo_Gallegos_Jr_Resume.pdf">
                { m["hero_section.download_cv"]() }

                <DownloadIcon/>
            </LinkButton>
            <LinkButton target="_blank" width="[14rem]" id="linkedinButton" href="https://www.linkedin.com/in/gerardo-gallegos-jr/">
                { m["hero_section.linkedin"]() }
                <span class="material-symbols-rounded w-6 h-6">
                    send
                </span>
            </LinkButton>
        </div>
    </div>
</div>
<style>
    [data-loading="true"] {
        opacity: 0;
        visibility: hidden;
    }
</style>
<script>
    import gsap from "gsap";
    import SplitText from "gsap/src/SplitText";

    const initHeroAnimation = () => {
        const title = document.querySelector("#hero-name");
        if (!title) return;

        // 1. ELIMINAR EL ESTADO DE CARGA (Ahora es visible para GSAP)
        title.removeAttribute("data-loading");
        
        // 2. HACER EL SPLIT INMEDIATAMENTE
        const split = new SplitText(title, { type: "words", wordsClass: "word-animated" });
        const { words } = split;

        // 3. SET INICIAL (Invisible por GSAP, no por CSS)
        gsap.set(words, {
            opacity: 0,
            scale: 0.8,
            y: 40
        });

        // Aplicar gradiente a la última palabra
        words[words.length - 1].classList.add(
            'bg-gradient-to-r', 'from-blue-500/80', 'to-blue-500', 
            'bg-clip-text', 'text-transparent'
        );

        // 4. ANIMACIÓN
        gsap.to(words, {
            duration: 0.8,
            opacity: 1,
            scale: 1,
            y: 0,
            ease: "back.out(1.7)",
            stagger: 0.1,
            delay: 0.1 // Pequeño margen para que el ojo se asiente tras el splash
        });
    };

    // Escuchar el evento que configuramos en el Layout
    window.addEventListener('startHeroAnimation', initHeroAnimation);
</script>